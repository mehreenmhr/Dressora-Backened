# ============================================================
# DRESSORA BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to git (it's in .gitignore)
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=5000
NODE_ENV=development
# NODE_ENV can be: development, production, test

# ============================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================
# These credentials must match your MySQL database setup

# MySQL host - usually localhost for local development
DB_HOST=localhost

# MySQL port - default is 3306
DB_PORT=3306

# MySQL database name - must be created beforehand
# Command: mysql -u root -p -e "CREATE DATABASE dressora;"
DB_NAME=dressora

# MySQL username - default is root
DB_USER=root

# MySQL password - your MySQL root password
# Leave empty if no password set (not recommended for production)
DB_PASSWORD=

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================

# JWT Secret - used to sign authentication tokens
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dressora_jwt_secret_key_change_this_in_production

# JWT Expiration - how long tokens are valid (e.g., "7d", "24h")
JWT_EXPIRATION=7d

# ============================================================
# MIGRATION SETTINGS (Optional - for MongoDB to MySQL conversion)
# ============================================================
# Only needed if you're migrating data from MongoDB
# Leave empty or comment out if not migrating

# MongoDB connection string for migration only
# MONGO_URI=mongodb://localhost:27017/dressora

# ============================================================
# LOGGING & DEBUGGING
# ============================================================

# Set to true to see all SQL queries in development
LOG_SQL=false

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
# 1. Copy this file: cp .env.example .env
# 2. Update DB_PASSWORD with your MySQL password
# 3. Ensure MySQL is running and database 'dressora' exists
# 4. Create tables: npm run db:sync
# 5. Start server: npm run dev
# ============================================================
